<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <Version>2.0.0-preview.1</Version>
    <Authors>Blake Drumm</Authors>
    <Company>Blake Drumm</Company>
    <Product>Easy Edge Apps</Product>
    <RepositoryUrl>https://github.com/blakedrumm/EasyEdgeApps</RepositoryUrl>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <WebsiteLauncherTemplate Condition="'$(WebsiteLauncherTemplate)' == ''">$(MSBuildThisFileDirectory)artifacts\launcher-net10-comparison\fresh-session.exe</WebsiteLauncherTemplate>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="ExpectedPublisherThumbprint" Value="$(ExpectedPublisherThumbprint)" />
  </ItemGroup>
</Project>