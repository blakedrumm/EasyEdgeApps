<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <AssemblyName>eea</AssemblyName>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../EasyEdgeApps.Windows/EasyEdgeApps.Windows.csproj" />
    <ProjectReference Include="../EasyEdgeApps.ImageWorker/EasyEdgeApps.ImageWorker.csproj" />
    <Content Include="$(WebsiteLauncherTemplate)" Link="WebsiteLauncher/fresh-session.exe" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>